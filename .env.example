# Node.js 24+. In aaPanel set these as environment variables or copy to .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Use an absolute directory OUTSIDE the Git checkout on the server.
DATA_DIR=/www/server/freedom-estimating-data
# Set true only behind your trusted aaPanel/Nginx reverse proxy.
TRUST_PROXY=true
# Generate each hash with npm run password -- "your-password".
# Use a unique account per person. Never commit real credentials.
APP_USERS={"boran":"scrypt:SALT:HASH","estimator":"scrypt:SALT:HASH"}
# Alternatively, set a shared website password hash (overrides account passwords).
# Keep the actual hash in .env or your server's environment, never in Git.
# SITE_PASSWORD_HASH=scrypt:SALT:HASH
